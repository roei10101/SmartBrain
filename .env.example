# Copy this file to .env and fill in real values. Never commit .env.
#   cp .env.example .env

# --- Database ---
POSTGRES_USER=postgres
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smartbrain

# --- Backend ---
# Signing key for JWT access tokens. Generate with: openssl rand -hex 32
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma separated list of origins that may call the API
CORS_ORIGINS=http://localhost:5173

# --- Frontend (build time) ---
# URL the browser uses to reach the API
VITE_API_URL=http://localhost:5000

# --- Monitoring (only with `--profile monitoring`) ---
GRAFANA_ADMIN_PASSWORD=change-me
